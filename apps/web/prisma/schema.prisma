generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// ============================================
// AUTH & USERS
// ============================================

model User {
  id            String    @id @default(cuid())
  clerkId       String    @unique
  email         String    @unique
  username      String?
  imageUrl      String?
  role          String    @default("user")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  favorites     Favorite[]
  progress      Progress[]
  newsViews     NewsView[]
  tipViews      TipView[]
  notifications UserNotificationPreference[]
}

// ============================================
// NEWS
// ============================================

model News {
  id            String    @id @default(cuid())
  title         String
  slug          String    @unique
  description   String
  content       String
  coverImage    String?
  category      String
  source        String
  sourceUrl     String
  publishedAt   DateTime
  updatedAt     DateTime  @updatedAt
  views         Int       @default(0)
  likes         Int       @default(0)
  trendingScore Float     @default(0)
  status        String    @default("published")
  createdAt     DateTime  @default(now())

  viewRecords   NewsView[]
}

model NewsView {
  id        String @id @default(cuid())
  userId    String
  newsId    String
  viewedAt  DateTime @default(now())

  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  news      News   @relation(fields: [newsId], references: [id], onDelete: Cascade)

  @@unique([userId, newsId])
}

// ============================================
// TIPS
// ============================================

model Tip {
  id                String    @id @default(cuid())
  title             String
  slug              String    @unique
  shortDescription  String
  fullExplanation   String
  category          String
  difficulty        String
  image             String?
  tags              String    @default("[]")
  views             Int       @default(0)
  likes             Int       @default(0)
  trendingScore     Float     @default(0)
  isCommunityTheory Boolean   @default(false)
  status            String    @default("published")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  viewRecords       TipView[]
}

model TipView {
  id       String   @id @default(cuid())
  userId   String
  tipId    String
  viewedAt DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tip      Tip      @relation(fields: [tipId], references: [id], onDelete: Cascade)

  @@unique([userId, tipId])
}

// ============================================
// GAME DATABASE — VEHICLES
// ============================================

model Vehicle {
  id            String    @id @default(cuid())
  name          String
  slug          String    @unique
  description   String?
  image         String?
  class         String?
  price         String    @default("Unknown")
  topSpeed      String    @default("Unknown")
  acceleration  String    @default("Unknown")
  handling      String    @default("Unknown")
  location      String?
  availability  String    @default("Coming soon")
  tags          String    @default("[]")
  metadata      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// ============================================
// GAME DATABASE — WEAPONS
// ============================================

model Weapon {
  id            String    @id @default(cuid())
  name          String
  slug          String    @unique
  description   String?
  image         String?
  category      String?
  damage        String    @default("Unknown")
  fireRate      String    @default("Unknown")
  range         String    @default("Unknown")
  accuracy      String    @default("Unknown")
  availability  String    @default("Coming soon")
  tags          String    @default("[]")
  metadata      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// ============================================
// GAME DATABASE — CHARACTERS
// ============================================

model Character {
  id            String    @id @default(cuid())
  name          String
  slug          String    @unique
  description   String?
  image         String?
  role          String?
  affiliation   String?
  status        String    @default("Unknown")
  tags          String    @default("[]")
  metadata      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  missions      Mission[]
}

// ============================================
// GAME DATABASE — MISSIONS
// ============================================

model Mission {
  id            String    @id @default(cuid())
  name          String
  slug          String    @unique
  description   String?
  image         String?
  chapter       String?
  type          String?
  difficulty    String?
  reward        String    @default("Unknown")
  location      String?
  tags          String    @default("[]")
  metadata      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  characterId   String?
  character     Character? @relation(fields: [characterId], references: [id], onDelete: SetNull)
}

// ============================================
// GAME DATABASE — LOCATIONS
// ============================================

model Location {
  id            String    @id @default(cuid())
  name          String
  slug          String    @unique
  description   String?
  image         String?
  type          String?
  region        String?
  latitude      Float?
  longitude     Float?
  tags          String    @default("[]")
  metadata      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// ============================================
// GAME DATABASE — COLLECTIBLES
// ============================================

model Collectible {
  id            String    @id @default(cuid())
  name          String
  slug          String    @unique
  description   String?
  image         String?
  category      String?
  location      String?
  latitude      Float?
  longitude     Float?
  tags          String    @default("[]")
  metadata      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// ============================================
// GAME DATABASE — PROPERTIES
// ============================================

model Property {
  id            String    @id @default(cuid())
  name          String
  slug          String    @unique
  description   String?
  image         String?
  type          String?
  price         String    @default("Unknown")
  location      String?
  latitude      Float?
  longitude     Float?
  tags          String    @default("[]")
  metadata      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// ============================================
// FAVORITES (polymorphic via entityType + entityId)
// ============================================

model Favorite {
  id            String    @id @default(cuid())
  userId        String
  entityType    String
  entityId      String
  createdAt     DateTime  @default(now())

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, entityType, entityId])
}

// ============================================
// PROGRESS (polymorphic via entityType + entityId)
// ============================================

model Progress {
  id            String    @id @default(cuid())
  userId        String
  entityType    String
  entityId      String
  completed     Boolean   @default(false)
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, entityType, entityId])
}

// ============================================
// NOTIFICATIONS
// ============================================

model UserNotificationPreference {
  id            String    @id @default(cuid())
  userId        String
  category      String
  enabled       Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
}
